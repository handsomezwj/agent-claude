# === Anthropic API 配置 ===
# 方式 1: 使用 Anthropic 官方 API
# ANTHROPIC_AUTH_TOKEN=sk-ant-xxxxxxxxx
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_MODEL=claude-opus-5

# 方式 2: 使用 DeepSeek 兼容端点 (Claude Code 当前配置)
ANTHROPIC_AUTH_TOKEN=sk-your-token-here
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_MODEL=deepseek-v4-pro

# === 可选配置 ===
# Claude 最大输出 token 数
# CLAUDE_MAX_TOKENS=16000
# 是否启用 extended thinking（第三方端点可能不支持，设为 false）
# ANTHROPIC_USE_THINKING=false

# === Agent 加的护栏/功能开关（默认全开，设 false 关闭） ===
# 每轮回答完请裁判模型打分
# CLAUDE_USE_JUDGE=true
# 超预算时把老对话压成摘要而不是扔掉
# CLAUDE_USE_SUMMARY=true
# 打字机流式输出
# CLAUDE_USE_STREAMING=true
# MCP 外部工具：配上启动命令，agent 启动时会问服务器要工具；
# 连不上自动降级只用内置工具，不会崩。示例命令（指向 learn-agent 的迷你天气服务器）：
# CLAUDE_USE_MCP=true
# CLAUDE_MCP_SERVER=python c:/Users/zwj/learn-agent/mcp_weather_server.py
# RAG 检索增强：默认读 learn-agent/knowledge.md，提问前先检索最相关的几块；
# 没找到知识库 / 加载失败都会优雅降级，照常聊天。CLAUDE_USE_RAG=false 可整体关掉。
# CLAUDE_USE_RAG=true
# CLAUDE_RAG_FILE=c:/Users/zwj/learn-agent/knowledge.md
# CLAUDE_RAG_TOP_K=2
# 向量检索：默认用向量余弦相似度找最像的块（本地词袋向量，免费）；
# 起不来 / 设 false 就回退的关键词打分。
# CLAUDE_USE_EMBEDDING=true
# 真向量模型：配了就把检索升级成语义检索（番茄搜得到西红柿）。
# 首次启动下载 ~100MB 模型，之后离线免费；加载失败自动回退假门。
# 国内网络可能需要：set HF_ENDPOINT=https://hf-mirror.com（命令行先 export）
# CLAUDE_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
